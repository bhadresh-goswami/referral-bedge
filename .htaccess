Options -Indexes

RewriteEngine On

# Protect hidden files (except .well-known)
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

# Block direct .env access
RewriteRule (^|/)\.env - [F,L,NC]

# Redirect requests to /public/ when not already there
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^$ public/ [R=302,L]
RewriteRule (.*) public/$1 [R=302,L]
