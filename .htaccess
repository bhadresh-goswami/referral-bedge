Options -Indexes

RewriteEngine On

# Redirect all requests to /public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [R=302,L]

# Protect hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block direct .env access
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
