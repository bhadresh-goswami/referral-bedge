Options -Indexes

RewriteEngine On

# Protect hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block direct .env access
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Route all non-existing files/folders to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
